# AWS Bedrock & Multi-Tier AI Provider Configuration
# (SynapseTV includes a full mock/fallback engine if keys are omitted)

# 1. AWS Bedrock Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# 2. Tier 1: Multimodal Vision
GEMINI_API_KEY=your_gemini_api_key

# 3. Tier 2: High-Speed Cognitive Decisions
NEBIUS_API_KEY=your_nebius_api_key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# 4. Tier 3: Fallback Reasoning Swarm
OPENROUTER_API_KEY=your_openrouter_api_key
